# Application
APP_NAME=Intelligent Job Matching System
ENVIRONMENT=local
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_USER=elip
POSTGRES_PASSWORD=elip
POSTGRES_DB=elip
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://elip:elip@postgres:5432/elip

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=resume_embeddings
QDRANT_SEARCH_LIMIT=20

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
BASELINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
HF_HOME=/models/huggingface

# Cross-Encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM re-ranking (Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
LLM_PROMPT_VERSION=v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=600

# Storage
RESUME_STORAGE_PATH=/data/resumes
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx

# Evaluation
EVALUATION_TOP_K=20
EVAL_METRICS=precision@5,recall@5,ndcg@10,mrr
